GEMINI_API_KEY=
# One key, or several separated by commas: key1,key2,key3. Each account is limited to CONTEXT_DEV_RPM
# requests a minute, so more keys means more capacity. Load is spread evenly; GET /status shows each key.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_RPM=10
# required to run: writes need this in an X-Terminal-Key header
TERMINAL_KEY=
DB_PATH=terminal.db
GEMINI_TEXT_MODEL=gemini-3.8-flash
# optional: the address the internet reaches this service at (no trailing slash). Turns on page watching:
# Context.dev monitors call back PUBLIC_URL/hooks/context/...
PUBLIC_URL=
