GEMINI_API_KEY=
# One key, or several separated by commas: key1,key2,key3. Each account allows CONTEXT_DEV_CONCURRENCY
# in-flight requests (500 on Scale); set CONTEXT_DEV_RPM only if a key also has a per-minute cap.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_CONCURRENCY=500
# required to run: writes need this in an X-Terminal-Key header
TERMINAL_KEY=
DB_PATH=terminal.db
GEMINI_TEXT_MODEL=gemini-3.8-flash
# optional: the model that writes down what the microphone hears; GEMINI_TEXT_MODEL when unset
GEMINI_SPEECH_MODEL=
# optional: the address the internet reaches this service at (no trailing slash). Turns on page watching:
# Context.dev monitors call back PUBLIC_URL/hooks/context/...
PUBLIC_URL=
