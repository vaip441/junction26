[Unit]
Description=junction26 Truth Social scraper: appends @realDonaldTrump's new posts to the feed file the terminal reads
After=network-online.target

[Service]
WorkingDirectory=/home/georg/junction26/junction26/trump-social-scraper
# Its own FlareSolverr port (8192), so it never leans on another copy's on the default 8191.
# The default 20 s between polls: 3 requests a minute, where Truth Social blocks an address after about 8.
# It must be the only scraper on this address: with a second one running, add --interval 30.
ExecStart=/usr/bin/python3 -u trump_scraper.py watch --utc --no-color --jsonl data/feed.jsonl --flaresolverr http://127.0.0.1:8192
Restart=always
RestartSec=10
TimeoutStopSec=40

[Install]
WantedBy=default.target
