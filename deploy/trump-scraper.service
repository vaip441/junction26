[Unit]
Description=junction26 Truth Social scraper: appends @realDonaldTrump's new posts to the feed file the terminal reads
After=network-online.target

[Service]
WorkingDirectory=/home/georg/junction26/junction26/trump-social-scraper
# Its own FlareSolverr port (8192), so it never leans on another copy's on the default 8191.
# 30 s between polls: Truth Social blocks an address after about 8 requests a minute, and a second
# scraper (3 a minute) runs on this machine. Drop --interval to get the default 20 s once that one is stopped.
ExecStart=/usr/bin/python3 -u trump_scraper.py watch --utc --no-color --jsonl data/feed.jsonl --flaresolverr http://127.0.0.1:8192 --interval 30
Restart=always
RestartSec=10
TimeoutStopSec=40

[Install]
WantedBy=default.target
