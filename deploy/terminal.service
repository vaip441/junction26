[Unit]
Description=junction26 terminal: scores live web ticks against prediction markets
After=network-online.target

[Service]
WorkingDirectory=/home/georg/junction26/junction26
EnvironmentFile=/home/georg/junction26/junction26/.env
# where the team's Truth Social scraper (trump-social-scraper/, run with `watch --jsonl`) appends new posts
Environment=TRUTH_FEED=/mnt/data/trevor/trump-social-scraper/data/feed.jsonl
ExecStart=/home/georg/junction26/junction26/.venv/bin/uvicorn terminal.api:app --host 127.0.0.1 --port 18911 --timeout-graceful-shutdown 5
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
