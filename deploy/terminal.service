[Unit]
Description=junction26 terminal: scores live web ticks against prediction markets
After=network-online.target

[Service]
WorkingDirectory=/home/georg/junction26/junction26
EnvironmentFile=/home/georg/junction26/junction26/.env
ExecStart=/home/georg/junction26/junction26/.venv/bin/uvicorn terminal.api:app --host 127.0.0.1 --port 18911
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
